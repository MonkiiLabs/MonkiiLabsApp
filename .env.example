# Monkii Labs — frontend environment
# Copy to .env and fill in. Every value has a working default except the
# WalletConnect project id.

# --- API ------------------------------------------------------------------
# Defaults to https://api.monkiilabs.app/api
VITE_API_BASE_URL=
# Used only when the primary host is unreachable.
VITE_API_FALLBACK_URL=

# --- Wallet ---------------------------------------------------------------
# Required for WalletConnect QR and mobile deep links. Without it the app
# still runs, but only browser-extension wallets can connect — which rules
# out the Robinhood Wallet in-app browser on mobile.
# Create a project at https://cloud.reown.com and paste the id here.
VITE_WALLETCONNECT_PROJECT_ID=

# --- Robinhood Chain (Arbitrum Orbit L2, chain id 4663) --------------------
# Defaults to https://rpc.robinhood.com
VITE_CHAIN_RPC_URL=
# Defaults to https://explorer.robinhood.com
VITE_CHAIN_EXPLORER_URL=
